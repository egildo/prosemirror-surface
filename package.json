{
  "name": "prosemirror-surface",
  "version": "0.0.1",
  "description": "Host chrome for ProseMirror editors: a floating toolbar element driven by plain specs",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "author": "Egildo Tagliareni",
  "license": "MIT",
  "peerDependencies": {
    "prosemirror-state": "^1.0.0",
    "prosemirror-view": "^1.0.0"
  },
  "devDependencies": {
    "happy-dom": "^20.0.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
